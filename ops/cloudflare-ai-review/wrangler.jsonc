{
  "name": "bob-free-ai-review",
  "main": "../../bob_ai_free_worker.mjs",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "preview_urls": false,
  "upload_source_maps": true,
  "ai": {
    "binding": "AI"
  },
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "issues": {
      "enabled": true
    },
    "traces": {
      "enabled": false
    }
  }
}

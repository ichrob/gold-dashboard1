{
  "name": "bob-watchdog-clock",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-08",
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "ENABLED": "false"
  },
  "triggers": {
    "crons": [
      "4,14,24,34,44,54 * * * *"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "CLOCK",
        "class_name": "WatchdogClock"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "WatchdogClock"
      ]
    }
  ],
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "issues": {
      "enabled": true
    },
    "traces": {
      "enabled": false
    }
  },
  "upload_source_maps": true
}

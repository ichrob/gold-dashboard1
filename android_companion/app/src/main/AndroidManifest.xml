<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          xmlns:tools="http://schemas.android.com/tools">
    <!-- Dependencies may declare network permissions in their own manifests.
         Explicitly remove them from the final merged APK: local OCR must be offline. -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />
    <queries><package android:name="nl.degiro.trader" /></queries>
    <!-- Optional one-shot reader; no gesture/screenshot/network capability. -->
    <application android:label="${bobAppLabel}"
                 android:allowBackup="false"
                 android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity android:name=".ProductReadActivity" android:exported="false" />
        <service android:name=".ProductReadService" android:exported="true"
                 android:label="@string/product_reader_label"
                 android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter><action android:name="android.accessibilityservice.AccessibilityService" /></intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/product_reader" />
        </service>
        <!-- Reuse the same in-memory approval session when Android Sharesheet returns a signed proposal. -->
        <activity android:name=".MainActivity" android:exported="true"
                  android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- ChatGPT/Bob text is only a proposed task. No auto-execution. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <!-- App-local safe link proposal: arbitrary callers can only request a
                 predefined Bob display. Never authorizes or executes by itself. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="bobhandy" android:host="handoff"
                      android:pathPrefix="/OPEN_" />
            </intent-filter>
            <!-- Verified HTTPS App Link. Android validates the public
                 certificate at /.well-known/assetlinks.json. Every link is
                 still treated as an untrusted single display proposal. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https"
                      android:host="bob-private-scanner.onrender.com"
                      android:pathPrefix="/handy/OPEN_" />
            </intent-filter>
            <!-- Only a user-initiated image share; never screen-capture other apps. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>
    </application>
</manifest>
